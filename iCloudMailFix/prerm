#!/bin/sh
set -e
LOG="/var/log/iCloudMailFixd.pkg.log"
PLIST="/Library/LaunchDaemons/com.victorlobe.iCloudMailFix.plist"
PIDFILE="/var/run/iCloudMailFixd.pid"

echo "[`date '+%F %T'`] prerm: stopping service…" >> "$LOG" 2>&1

# Unload (nicht hängen, Fehler ignorieren)
if [ -f "$PLIST" ]; then
  /bin/launchctl unload "$PLIST" >> "$LOG" 2>&1 || true
fi

# Altes PID-Lock entfernen, damit neue Version starten kann
[ -f "$PIDFILE" ] && rm -f "$PIDFILE"

# Runtime CA update files are not package-owned, so remove them explicitly.
rm -f /Library/iCloudMailFix/cacert.override.pem
rm -f /Library/iCloudMailFix/cacert.override.pem.tmp
rm -f /var/mobile/Library/Preferences/com.victorlobe.icloudmailfix-ca-update
rm -f /var/mobile/Library/Preferences/com.victorlobe.icloudmailfix-ca-update-status

exit 0
